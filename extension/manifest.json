{
  "manifest_version": 3,
  "name": "AGX Bridge",
  "version": "0.1.0",
  "description": "AgenticX 桌面端浏览器代理：划词/整页发给 AGX 会话，并让 AGX 代理在你的浏览器里执行打开页面、提取、填表、截图等操作",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "scripting", "activeTab", "tabs", "contextMenus", "notifications"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": { "128": "icons/icon128.png" },
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_title": "AGX Bridge",
    "default_popup": "src/popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
