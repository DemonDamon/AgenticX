{
  "manifest_version": 3,
  "name": "AGX Bridge Spike",
  "version": "0.0.1",
  "description": "SP1 NM channel spike — debug only, not for store distribution",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "scripting", "activeTab", "tabs", "contextMenus", "notifications"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_title": "AGX Bridge Spike",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
