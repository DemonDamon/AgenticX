# Build from the enterprise/ directory, for example:
#   docker build -f apps/Dockerfile.next \
#     --build-arg APP_NAME=web-portal \
#     --build-arg APP_PACKAGE=@agenticx/app-web-portal \
#     --build-arg APP_PORT=3000 \
#     -t ghcr.io/agenticx/enterprise-web-portal:local .
#
#   docker build -f apps/Dockerfile.next \
#     --build-arg APP_NAME=admin-console \
#     --build-arg APP_PACKAGE=@agenticx/app-admin-console \
#     --build-arg APP_PORT=3001 \
#     --build-arg NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL=https://gateway.example.com \
#     -t ghcr.io/agenticx/enterprise-admin-console:local .
#
# NEXT_PUBLIC_* 在构建期被内联进前端产物，运行期再设环境变量不生效：
# 生产构建必须按实际对外地址传入，否则前端会回落到 127.0.0.1 / localhost 默认值。

FROM node:20-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /work
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY features ./features
COPY packages ./packages
COPY plugins ./plugins
# pnpm-lock.yaml 由各环境本地生成且不入库（见 enterprise/.gitignore），
# --frozen-lockfile 会让镜像构建在干净 clone 上必然失败。
RUN pnpm install --no-frozen-lockfile

FROM deps AS build
ARG APP_NAME
ARG APP_PACKAGE
ARG BUILD_DATABASE_DIALECT=postgresql
ARG BUILD_DATABASE_URL=postgresql://agenticx:agenticx@127.0.0.1:5432/agenticx?sslmode=disable
# 前端 NEXT_PUBLIC_* 构建期内联，必须在这里给定，运行期环境变量不会生效。
# 管理后台入口默认走同源 /admin/（nginx 已代理），无需按客户域名单独配置。
ARG NEXT_PUBLIC_ADMIN_CONSOLE_URL=/admin/
ARG NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL=
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_ADMIN_CONSOLE_URL=${NEXT_PUBLIC_ADMIN_CONSOLE_URL}
ENV NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL=${NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL}
ENV DATABASE_DIALECT=${BUILD_DATABASE_DIALECT}
ENV DATABASE_URL=${BUILD_DATABASE_URL}
RUN pnpm --filter "${APP_PACKAGE}" build
RUN mkdir -p "apps/${APP_NAME}/public"

FROM node:20-bookworm-slim AS runner
ARG APP_NAME
ARG APP_PORT=3000
# 服务端路由（如 /api/desktop/capabilities）运行期也读这个变量，沿用构建期取值。
ARG NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL=
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=${APP_PORT}
ENV NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL=${NEXT_PUBLIC_GATEWAY_PUBLIC_BASE_URL}
WORKDIR /app/apps/${APP_NAME}

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

# directFetch 优先用 curl 以继承 HTTP(S)_PROXY / SOCKS（Node undici 不读这些环境变量）。
# slim 基础镜像不含 curl，缺失时每次外站抓取都会白 fork 一个 ENOENT 子进程。
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=nextjs:nodejs /work/apps/${APP_NAME}/.next/standalone /app
COPY --from=build --chown=nextjs:nodejs /work/apps/${APP_NAME}/.next/static /app/apps/${APP_NAME}/.next/static
COPY --from=build --chown=nextjs:nodejs /work/apps/${APP_NAME}/public /app/apps/${APP_NAME}/public

USER nextjs
EXPOSE ${APP_PORT}
CMD ["node", "server.js"]
