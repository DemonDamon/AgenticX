{
  "name": "agenticx-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Near — AgenticX Desktop",
  "author": "DemonDamon",
  "productName": "Near",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cp electron/splash.html dist-electron/splash.html 2>/dev/null || true && concurrently \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"node scripts/wait-and-electron.mjs\"",
    "icons:sync": "bash ./scripts/sync-icons.sh",
    "test": "vitest run src tests",
    "test:native-connectors": "vitest run tests/native-connectors-core.test.ts",
    "test:action-confirmation": "vitest run tests/action-confirmation.test.ts tests/session-message-action-confirmation.test.ts",
    "build": "vite build && tsc -p electron/tsconfig.json && cp electron/splash.html dist-electron/splash.html",
    "start": "electron .",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:mac:all": "npm run build && electron-builder --mac --arm64 && electron-builder --mac --x64",
    "build:win": "npm run build && electron-builder --win",
    "build:win:bundled": "pwsh -NoProfile -File ../packaging/build_windows_installer.ps1",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@dicebear/core": "10.6.0",
    "@dicebear/styles": "10.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.14",
    "@xihe-lab/tapd-mcp-server": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "echarts": "^5.6.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.10.10",
    "js-yaml": "^4.3.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "mermaid": "^11.13.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tar": "^7.5.22",
    "undici": "^6.28.1",
    "unist-util-visit": "^5.0.0",
    "whisper-wasm": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.51.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.14",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.12.0",
    "@xmldom/xmldom": "0.9.12",
    "axios": "^1.20.0",
    "fast-uri": "^3.1.7",
    "braces": "^3.0.3",
    "brace-expansion": "^2.0.2",
    "tmp": "^0.2.7",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.0",
    "ip-address": "^10.3.1",
    "form-data": "^4.0.6",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "extract-zip": "^2.0.1"
  }
}
